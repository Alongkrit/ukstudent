// Scholza — Prisma schema
// Source: Technical Architecture Document, Section 3 (Data Model)
// Reconciled production schema with data preservation guarantees.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  student
  expert
  admin
}

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ExpertDocumentType {
  identity
  qualification
}

enum ExpertDocumentStatus {
  pending
  approved
  rejected
}

enum RequestStatus {
  submitted
  matching
  matched
  in_progress
  completed
  cancelled
}

enum ConversationStatus {
  active
  resolved
  archived
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum PayoutStatus {
  scheduled
  processing
  paid
  failed
}

enum NotificationType {
  request_matched
  request_matching_timeout
  new_message
  application_approved
  application_rejected
  payment_receipt
  payout_sent
  review_received
  moderation_action
}

enum ReportReason {
  inappropriate_content
  harassment
  spam
  fraud
  other
}

enum ReportStatus {
  pending
  investigating
  resolved
  dismissed
}

// ---------------------------------------------------------------------------
// Users & profiles
// ---------------------------------------------------------------------------

model User {
  id                         String     @id @default(uuid())
  role                       UserRole
  email                      String     @unique
  passwordHash               String?    @map("password_hash")
  phone                      String?
  status                     UserStatus @default(active)
  emailVerifiedAt            DateTime?  @map("email_verified_at")
  emailVerificationCodeHash  String?    @map("email_verification_code_hash")
  emailVerificationExpiresAt DateTime?  @map("email_verification_expires_at")
  passwordResetTokenHash     String?    @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime?  @map("password_reset_expires_at")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  studentProfile      StudentProfile?
  expertProfile       ExpertProfile?
  refreshTokens       RefreshToken[]
  oauthAccounts       OAuthAccount[]
  requestsAsStudent   Request[]           @relation("StudentRequests")
  requestsAsExpert    Request[]           @relation("ExpertRequests")
  conversationsAsStudent Conversation[]   @relation("StudentConversations")
  conversationsAsExpert  Conversation[]   @relation("ExpertConversations")
  messages            Message[]
  payments            Payment[]
  payouts             Payout[]
  reviewsGiven        Review[]            @relation("ReviewAuthor")
  reviewsReceived     Review[]            @relation("ReviewSubject")
  notifications       Notification[]
  attachmentsUploaded RequestAttachment[]
  reportsFiled        Report[]            @relation("ReportsFiled")
  reportsResolved     Report[]            @relation("ReportsResolved")

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model StudentProfile {
  userId      String  @id @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  university  String
  course      String
  yearOfStudy String  @map("year_of_study")
  fullName    String? @map("full_name")

  @@map("student_profiles")
}

model ExpertProfile {
  userId             String             @id @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects           String[]
  qualifications     String
  bio                String?
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason")
  ratingAvg          Decimal            @default(0) @db.Decimal(3, 2) @map("rating_avg")
  isAvailable        Boolean            @default(false) @map("is_available")
  stripeAccountId    String?            @map("stripe_account_id")
  paypalEmail        String?            @map("paypal_email")

  documents          ExpertDocument[]

  @@map("expert_profiles")
}

model ExpertDocument {
  id              String               @id @default(uuid())
  expertId        String               @map("expert_id")
  expert          ExpertProfile        @relation(fields: [expertId], references: [userId], onDelete: Cascade)
  docType         ExpertDocumentType   @map("doc_type")
  fileUrl         String               @map("file_url")
  fileName        String?              @map("file_name")
  mimeType        String?              @map("mime_type")
  sizeBytes       Int?                 @map("size_bytes")
  storageKey      String?              @map("storage_key")
  status          ExpertDocumentStatus @default(pending)
  rejectionReason String?              @map("rejection_reason")
  reviewedAt      DateTime?            @map("reviewed_at")
  reviewerId      String?              @map("reviewer_id")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([expertId])
  @@map("expert_documents")
}

// ---------------------------------------------------------------------------
// Service catalogue
// ---------------------------------------------------------------------------

model Service {
  id          String    @id @default(uuid())
  name        String
  description String
  icon        String?
  isActive    Boolean   @default(true) @map("is_active")
  price       Decimal   @default(45.00) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")

  requests    Request[]

  @@map("services")
}

// ---------------------------------------------------------------------------
// Requests & matching
// ---------------------------------------------------------------------------

model Request {
  id                String        @id @default(uuid())
  studentId         String        @map("student_id")
  student           User          @relation("StudentRequests", fields: [studentId], references: [id])
  serviceId         String        @map("service_id")
  service           Service       @relation(fields: [serviceId], references: [id])
  subject           String
  title             String
  description       String
  deadlineAt        DateTime      @map("deadline_at")
  status            RequestStatus @default(submitted)
  matchedExpertId   String?       @map("matched_expert_id")
  matchedExpert     User?         @relation("ExpertRequests", fields: [matchedExpertId], references: [id])
  matchingWidenedAt DateTime?     @map("matching_widened_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  attachments RequestAttachment[]
  conversation Conversation?
  payment      Payment?
  review       Review?
  reports      Report[]

  @@index([studentId])
  @@index([matchedExpertId])
  @@index([status])
  @@map("requests")
}

model RequestAttachment {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  uploadedBy String   @map("uploaded_by")
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  mimeType   String?  @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  storageKey String?  @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@map("request_attachments")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Conversation {
  id        String             @id @default(uuid())
  requestId String             @unique @map("request_id")
  request   Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId String             @map("student_id")
  student   User               @relation("StudentConversations", fields: [studentId], references: [id])
  expertId  String             @map("expert_id")
  expert    User               @relation("ExpertConversations", fields: [expertId], references: [id])
  status    ConversationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")

  messages Message[]
  reports  Report[]

  @@index([studentId])
  @@index([expertId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  attachmentUrl  String?      @map("attachment_url")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Moderation reports (SEC-6 / ADM-5)
// ---------------------------------------------------------------------------

model Report {
  id             String        @id @default(uuid())
  reporterId     String        @map("reporter_id")
  reporter       User          @relation("ReportsFiled", fields: [reporterId], references: [id])
  requestId      String?       @map("request_id")
  request        Request?      @relation(fields: [requestId], references: [id])
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  reason         String
  details        String?
  status         ReportStatus  @default(pending)
  actionTaken    String?       @map("action_taken")
  resolvedById   String?       @map("resolved_by_id")
  resolvedBy     User?         @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([reporterId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Audit Logs (SEC-4)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String?  @map("target_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Payments & payouts
// ---------------------------------------------------------------------------

model Payment {
  id                    String        @id @default(uuid())
  requestId             String        @unique @map("request_id")
  request               Request       @relation(fields: [requestId], references: [id])
  studentId             String        @map("student_id")
  student               User          @relation(fields: [studentId], references: [id])
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("GBP")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  paypalCaptureId       String?       @unique @map("paypal_capture_id")
  paypalOrderId         String?       @unique @map("paypal_order_id")
  status                PaymentStatus @default(pending)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Payout {
  id                  String       @id @default(uuid())
  expertId            String       @map("expert_id")
  expert              User         @relation(fields: [expertId], references: [id])
  amount              Decimal      @db.Decimal(10, 2)
  currency            String       @default("GBP")
  stripeTransferId    String?      @map("stripe_transfer_id")
  paypalPayoutBatchId String?      @map("paypal_payout_batch_id")
  status              PayoutStatus @default(scheduled)
  periodStart         DateTime     @map("period_start")
  periodEnd           DateTime     @map("period_end")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@index([expertId])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  requestId String   @unique @map("request_id")
  request   Request  @relation(fields: [requestId], references: [id])
  studentId String   @map("student_id")
  student   User     @relation("ReviewAuthor", fields: [studentId], references: [id])
  expertId  String   @map("expert_id")
  expert    User     @relation("ReviewSubject", fields: [expertId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expertId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Blog (Admin-managed CMS)
// ---------------------------------------------------------------------------

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  category    String
  body        String
  readTimeMin Int?      @map("read_time_min")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}