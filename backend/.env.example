# --- App ---
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
WEB_APP_ORIGIN=http://localhost:3000
ADMIN_APP_ORIGIN=http://localhost:3002

# --- Database (PostgreSQL, managed in staging/prod) ---
DATABASE_URL="postgresql://ukss:ukss_dev_password@127.0.0.1:5433/ukss_dev?schema=public"

# --- Redis (cache, rate limiting, BullMQ queues, Socket.IO adapter) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (see Security & Access Document, Section 3.2) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- PayPal (Payments & Payouts) ---
PAYPAL_CLIENT_ID=BAA3pEAB8iabKUpd5GrYoC-inmda_LOdCRmlhPujqFSbrDLFFiIm3d6irtUzbfkwsj3aWLNMZU9ND9l3kM
PAYPAL_CLIENT_SECRET=EGtU08N9DQlFgOzFkRE3dn1dNC5MJ6r5VYmF9GKLKRQclsNuW-M_fbz4TajmNpdZXNWLKzz-AnnjdWKS
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=mock_paypal_webhook_id

# --- File storage (S3-compatible, signed URLs only — never public buckets) ---
S3_REGION=eu-west-2
S3_BUCKET_PRIVATE=ukss-private-uploads
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_UPLOAD_MAX_SIZE_MB=25

# --- Notifications ---
ONESIGNAL_APP_ID=change-me
ONESIGNAL_API_KEY=change-me
EMAIL_PROVIDER=postmark
EMAIL_FROM="Scholza <no-reply@ukstudentsupport.co.uk>"
POSTMARK_SERVER_TOKEN=change-me

# --- Monitoring ---
SENTRY_DSN=
